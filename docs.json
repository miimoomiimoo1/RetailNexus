{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RetailNexus",
  "colors": {
    "primary": "#C40000",
    "light": "#C40000",
    "dark": "#B00000"
  },
  "favicon": {
    "light": "/images/kuva_2026-10-10_014650405.png",
    "dark": "/images/kuva_2026-10-10_014650405.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/kuva_2026-10-10_014650405.png",
    "dark": "/images/kuva_2026-10-10_014650405.png"
  },
  "navbar": {
    "links": [
      {
        "href": "https://www.discord.gg/qkaTueJkQx",
        "label": "Discord"
      }
    ],
    "primary": {
      "type": "discord",
      "href": "https://www.discord.gg/qkaTueJkQx"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://www.discord.gg/qkaTueJkQx",
      "website": "https://www.retailnexus.work.gd"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "gradient"
  },
  "appearance": {
    "default": "dark"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  }
}
